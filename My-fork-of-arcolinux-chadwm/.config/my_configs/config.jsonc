// Converted from a neofetch config (BlockFetch by Chick) to fastfetch.
// Original: https://github.com/Chick2D/neofetch-themes/
// Save as ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "debian_small",   // ascii_distro="debian_small"
    "padding": {
      "right": 2                // gap=2
    }
  },

  "display": {
    "separator": "  "           // neofetch had separator=""
  },

  // keyColor uses the same bold ANSI codes as the original (\033[1;3Xm)
  "modules": [
    { "type": "os",       "key": "  ██ Distro",   "keyColor": "1;31", "format": "{3}" },  // {3} = pretty name, no arch (os_arch="off")
    { "type": "kernel",   "key": "  ██ Kernel",   "keyColor": "1;32" },
    { "type": "uptime",   "key": "  ██ Uptime",   "keyColor": "1;33" },
    { "type": "shell",    "key": "  ██ Shell",    "keyColor": "1;34" },
    { "type": "packages", "key": "  ██ Packages", "keyColor": "1;35" },
    { "type": "wm",       "key": "  ██ WM",       "keyColor": "1;36" },
    { "type": "cpu",      "key": "  ██ CPU",      "keyColor": "1;34" },
    { "type": "memory",   "key": "  ██ Memory",   "keyColor": "1;37" }

    // neofetch's `info cols` did nothing because color_blocks="off".
    // To show color blocks, add a comma after the memory module and uncomment:
    // , "break"
    // , { "type": "colors", "symbol": "block" }
  ]
}
